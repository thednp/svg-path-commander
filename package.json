{
  "name": "svg-path-commander",
  "version": "2.3.5",
  "description": "🛹 Modern TypeScript tools for SVG",
  "keywords": [
    "absolute",
    "commander",
    "convert",
    "curve",
    "intersect",
    "normalize",
    "optimize",
    "parse",
    "path",
    "relative",
    "reverse",
    "svg",
    "transform3d",
    "typescript"
  ],
  "homepage": "http://thednp.github.io/svg-path-commander",
  "bugs": {
    "url": "https://github.com/thednp/svg-path-commander/issues"
  },
  "license": "MIT",
  "author": "thednp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thednp/svg-path-commander.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./util": "./dist/util.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "pre-test": "vpr clean-coverage",
    "dev": "vp dev docs --port 3000",
    "test": "vp test",
    "test:ui": "vp test --ui --watch",
    "test:watch": "vp test --watch",
    "clean-coverage": "rm -rf coverage .nyc_output",
    "format": "vp fmt src",
    "lint": "vpr lint:ts && vpr check:ts",
    "bench": "node scripts/bench.js",
    "fix:ts": "vp lint --fix src",
    "lint:ts": "vp lint src",
    "check:ts": "tsc --noEmit",
    "up:deno": "deno update --latest && deno run -A scripts/update-deno.js",
    "build": "vp pack && vpr copy-docs",
    "copy-docs": "cp dist/index.min.js docs/index.min.js && cp dist/index.min.js.map docs/index.min.js.map",
    "prepublishOnly": "vp up --latest && vpr up:deno && vpr format && vpr lint:ts && vpr build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@thednp/dommatrix": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "catalog": {
    "vitest": "5.1.0",
    "vite-plus": "1.6.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/ui": "5.1.0"
  }
}